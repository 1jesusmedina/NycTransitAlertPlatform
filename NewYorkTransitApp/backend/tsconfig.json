{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "/opt/nodejs/*": ["./layers/shared/nodejs/*"]
    }
  },
  "include": ["functions/**/*.ts", "layers/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
